<main id="main-content">
 <section class="clear-page-intro contact-refresh"><div class="container">
  <h1>Contact GetMacros</h1>
  <p>Questions, ideas or something not working? I read and reply to every email.</p>
  <div class="contact-choices"><a class="btn action-link" href="#contact-draft" data-contact-topic="idea">Suggest an improvement</a><a class="btn action-link" href="#contact-draft" data-contact-topic="problem">Report a problem</a></div>
  <div class="contact-address"><span class="contact-address-label">Email me directly</span><a class="contact-email-address" href="mailto:getmacros.net@outlook.com">getmacros.net@outlook.com</a><button type="button" class="btn" data-copy-address>Copy email address</button></div>
  <div class="contact-browser-links"><a class="btn btn-primary" data-webmail="gmail" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=getmacros.net%40outlook.com" target="_blank" rel="noopener noreferrer">Email with Gmail</a><a class="btn action-link" data-webmail="outlook" href="https://outlook.live.com/mail/0/deeplink/compose?to=getmacros.net%40outlook.com" target="_blank" rel="noopener noreferrer">Email with Outlook</a></div><p class="contact-hint">Opens your mail service in a new tab. Sign in if needed.</p>
  <p id="contact-copy-status" class="contact-status" role="status"></p>
 </div></section>
 <section class="contact-draft-section" id="contact-draft" aria-labelledby="contact-draft-title"><div class="container">
  <h2 id="contact-draft-title">Write your message</h2>
  <form id="contact-form">
   <label for="contact-topic">What’s it about?</label>
   <select id="contact-topic" name="topic"><option value="question">A question</option><option value="idea">An idea for the site</option><option value="problem">Something isn’t working</option></select>
   <label for="contact-message">Your message</label>
   <p class="contact-hint" id="contact-hint">Tell me what you’d like to know. Please leave out private health details.</p>
   <textarea id="contact-message" name="message" rows="6" maxlength="3000" required aria-describedby="contact-hint"></textarea>
   <div class="contact-draft-actions"><a class="btn btn-primary" data-webmail="gmail" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=getmacros.net%40outlook.com" target="_blank" rel="noopener noreferrer">Open Gmail draft</a><a class="btn action-link" data-webmail="outlook" href="https://outlook.live.com/mail/0/deeplink/compose?to=getmacros.net%40outlook.com" target="_blank" rel="noopener noreferrer">Open Outlook draft</a><a id="contact-email-draft" class="btn action-link" href="mailto:getmacros.net@outlook.com">Use my email app</a><button type="button" disabled class="btn action-link" data-copy-message>Copy message</button></div>
   <p class="contact-hint">Choose Gmail or Outlook to continue in your browser, or use an installed email app. You review and send the email there.</p>
   <p id="contact-draft-status" class="contact-status" role="status"></p>
   <div id="contact-copy-fallback" hidden><label for="contact-copy-text">Select and copy these details</label><textarea id="contact-copy-text" rows="6" readonly></textarea></div>
  </form>
  <noscript><p>The draft builder needs JavaScript. You can email getmacros.net@outlook.com directly.</p></noscript>
 </div></section>
</main>
